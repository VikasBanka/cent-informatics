# Copy to .env and change every value before using this anywhere but a local
# machine. .env is gitignored; never commit real credentials.
#
# Every variable here overrides a `runtimeConfig` key in nuxt.config.ts, so the
# defaults in that file are what runs when a variable is unset.

# The cent-informatics FastAPI service, which owns the data. Matches the
# API_PORT in the API's docker-compose.
NUXT_API_BASE_URL=http://localhost:8000

# The RabbitMQ broker the analysis panel queues work on. Use the same credentials
# the API's docker-compose gives its own services -- RABBITMQ_USER and
# RABBITMQ_PASSWORD from the API repo's .env -- and the host-published
# RABBITMQ_PORT, since this app runs outside that compose network.
#
# There is no usable default: the compose file replaces RabbitMQ's `guest`
# account with RABBITMQ_USER, so a connection without credentials is refused.
NUXT_RABBITMQ_URL=amqp://cent:change-me-locally@localhost:5672/
